<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.liu.kb-tunnel</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cloudflared tunnel --config ~/.cloudflared/knowledge-garden.yml run</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/liu/Library/Logs/kb-tunnel.log</string>
  <key>StandardErrorPath</key><string>/Users/liu/Library/Logs/kb-tunnel.log</string>
</dict>
</plist>
